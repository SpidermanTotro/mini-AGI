# Corpora: hundreds of megabytes of .bin, rebuilt by `python3 -m corpora.*`
data_*/

# Model checkpoints are local runtime state, never source files.
# The canonical checkpoint lives under weights/. Legacy/local exports may also
# exist as loose root-level bundles; ignore those too so `git add .` cannot
# accidentally stage trained weights or optimizer state.
weights/
weights-*/
/core.npz
/routers.npz
/optim.npz
/manifest.json
/experts/
agi-16/
agi-16-large/
greenlight-16g-r1/
greenlight-16g-r1-*/
greenlight-16g-lab/

# Run artefacts: logs, checkpoints, plots
runs/*
!runs/samples.txt

__pycache__/
*.pyc

# the training corpus - 1.2 GB of text, regenerated by tools/expand_corpus.py
data/
runs/corpus_index.json

# secrets
.env
.env.*

# Local Python environments and packaging/test artefacts
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
build/
dist/
*.egg-info/

# Common editor / OS metadata
.vscode/
.idea/
.DS_Store
